NODE_ENV=development
PORT=8787

# Secreto solo del servidor. Nunca lo incrustes en React ni en la extension.
SWAT_MCP_URL=https://neuralbus.norug.es/mcp
SWAT_MCP_API_KEY=replace-with-server-secret
SWAT_MCP_FEED_TOOLS=neuralbus_health,bitcoin_public_observer_status
SWAT_MCP_QUERY_TOOL=
SWAT_MCP_QUERY_ARG=query
SWAT_GATEWAY_HOST=127.0.0.1
SWAT_PUBLIC_ORIGINS=http://localhost:3000,http://localhost:5173
SWAT_RATE_LIMIT_PER_MINUTE=60
SWAT_MAX_BODY_BYTES=1048576
SWAT_MAX_QUERY_LENGTH=500

